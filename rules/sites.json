  "guides": [
    {
      "siteId": "ebay",
      "title": "Chiavi API di eBay",
      "summary": "Gratis. Con le chiavi eBay risponde più in fretta, con la spedizione calcolata sul tuo CAP e senza blocchi.",
      "fields": [
        { "id": "ebay_client_id", "label": "App ID (Client ID)", "hint": "es. MarioRos-ShopAI-PRD-1a2b3c4d5-6e7f8a9b" },
        { "id": "ebay_client_secret", "label": "Cert ID (Client Secret)", "hint": "es. PRD-1a2b3c4d5e6f-7a8b-9c0d-1e2f-3a4b" }
      ],
      "steps": [
        { "text": "Accedi a eBay Developers Program con il tuo account eBay (o creane uno) e accetta i termini.", "link": "https://developer.ebay.com/signin", "linkLabel": "Apri eBay Developers" },
        { "text": "Conferma l'indirizzo email che ti arriva da eBay." },
        { "text": "Apri la pagina Application Keys.", "link": "https://developer.ebay.com/my/keys", "linkLabel": "Apri Application Keys" },
        { "text": "Nella colonna Production scrivi un nome per l'app (es. ShopAI) e premi \"Create a keyset\"." },
        { "text": "Se eBay chiede le notifiche di cancellazione account (Marketplace Account Deletion), scegli l'esenzione: ShopAI è un'app personale e non salva dati di altri utenti eBay." },
        { "text": "Copia App ID (Client ID) e Cert ID (Client Secret) della colonna Production e incollali qui sotto. Il Dev ID non serve." },
        { "text": "Premi Verifica: se vedi ✓ eBay userà l'API." }
      ],
      "notes": ["Usa il keyset Production, non Sandbox: quello Sandbox non vede gli annunci veri.", "Limite gratuito: 5.000 ricerche al giorno, più che sufficienti."]
    },
    {
      "siteId": "aliexpress",
      "title": "Chiavi API di AliExpress",
      "summary": "Gratis. Con le chiavi AliExpress dà prezzi in € e spedizione verso l'Italia senza CAPTCHA.",
      "fields": [
        { "id": "ali_app_key", "label": "App Key", "hint": "numero di 6-8 cifre" },
        { "id": "ali_app_secret", "label": "App Secret", "hint": "stringa di 32 caratteri" },
        { "id": "ali_tracking_id", "label": "Tracking ID", "hint": "es. shopai", "secret": false }
      ],
      "steps": [
        { "text": "Iscriviti al programma affiliati AliExpress con il tuo account AliExpress e completa il profilo.", "link": "https://portals.aliexpress.com", "linkLabel": "Apri AliExpress Portals" },
        { "text": "Nel portale apri Account → Tracking ID e creane uno (es. shopai). Copialo nel campo Tracking ID." },
        { "text": "Registrati come sviluppatore su AliExpress Open Platform (profilo Affiliate, persona fisica).", "link": "https://openservice.aliexpress.com", "linkLabel": "Apri Open Platform" },
        { "text": "Da App Console crea un'app di tipo \"Affiliates API\". L'approvazione può richiedere da 1 a qualche giorno lavorativo." },
        { "text": "Quando l'app è approvata, apri App Overview e copia App Key e App Secret qui sotto." },
        { "text": "Premi Verifica: se vedi ✓ AliExpress userà l'API." }
      ],
      "notes": ["Finché l'app non è approvata la verifica risponde \"app non ancora approvata\": intanto ShopAI legge AliExpress dalla pagina."]
    },
    {
      "siteId": "amazon",
      "title": "Amazon (nessuna chiave per ora)",
      "summary": "Amazon viene letto dalla pagina: non serve nessuna chiave. Imposta solo il CAP con \"Prepara\".",
      "fields": [],
      "steps": [
        { "text": "Impostazioni → Siti → Amazon → Prepara: si apre Amazon, ShopAI inserisce il CAP e salva i cookie.", "linkLabel": "" },
        { "text": "Se Amazon mostra un CAPTCHA, risolvilo una volta: i cookie restano salvati." },
        { "text": "Facoltativo, più avanti: l'API ufficiale di Amazon è riservata agli affiliati che hanno già fatto alcune vendite con i propri link.", "link": "https://programma-affiliazione.amazon.it", "linkLabel": "Programma affiliazione Amazon" }
      ],
      "notes": []
    }
  ]
